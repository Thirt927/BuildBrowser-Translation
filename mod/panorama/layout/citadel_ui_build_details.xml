<!--
  BuildBrowser Translation - override of panorama/layout/citadel_ui_build_details.xml

  Two kinds of change against Valve's layout:

  1. The engine-owned labels (build name, build description) are translated in
     place; on every build switch / manual refresh the mod re-applies their
     #token so the engine re-resolves the new English (see resyncLabel in
     bba_translate.js), then translates again.

  2. A compact "翻译 / 刷新 / 中" toolbar (three native TextButtons) sits inside
     the engine's own control row (#ControlArea), immediately before
     #BuildControls. It adds no new row and no overlay: the buttons live where
     the engine already hit-tests, so they are clickable by construction.
     The "中" button cycles 中文 → 原文 → 中英对照 (mode:next), replacing the
     v1.9.8 dropdown, which had to drop outside its host row's bounds and could
     therefore never be clicked reliably. (The v1.9.8 #BuildInfo row, the
     v1.9.9 root child and the v1.9.10/v1.9.11 full-pane overlay are all
     retired for that same reason.)
-->
<root>
	<styles>
		<include src="s2r://panorama/styles/citadel_base_styles.vcss" />
		<include src="s2r://panorama/styles/citadel_ui_build_details.vcss" />
		<include src="s2r://panorama/styles/avatar_image.vcss" />
		<include src="s2r://panorama/styles/bba.css" />
	</styles>
	<scripts>
		<include src="s2r://panorama/scripts/bba_glossary.vjs_c" />
		<include src="s2r://panorama/scripts/bba_tm.vjs_c" />
		<include src="s2r://panorama/scripts/bba_layout_tokens.vjs_c" />
		<include src="s2r://panorama/scripts/bba_translate.vjs_c" />
	</scripts>

	<CitadelBuildDetails>
		<!-- optional live-bridge panel: must be declared in the layout (a runtime CreatePanel is not a real HTML panel) -->
		<HTML id="BBTBridgePanelDetails" class="BBTBridgePanel" />
		<GlobalClassListener classes="gShopOpen" />
		<Panel class="HeroBuildsExtraInfo">
			<Panel id="Background" />
			<Panel id="BuildInfo">
			<Panel class="AuthoringInfo">
				<!-- engine-owned (text="#Token" whose value is {s:selected_hero_build_name}) -->
				<Label class="BuildName" text="#Citadel_HeroBuilds_BuildName" html="true" />
				<!-- v1.9.27 (field bug ①): the two-state trigger moved OUT of the
					 engine's #BuildControls row (the Medium Fill squeeze overlapped
					 复制出装/BuildOptions on the browser overview) into the RIGHT edge
					 of this title row. The engine only puts the build name on the
					 LEFT of the row, so the top-right corner is clear and the button
					 can no longer stack over an engine control. #BBTTabBtnHost is the
					 absolute-positioning anchor (bba.css); BBTActMark2 (the uiGuard
					 ledger) rides with the button so it stays out of scanner view.
					 The in-game embedded category frames keep the header button #3 as
					 their two-state control; #2 only shows on the browser surfaces
					 (wireToolbar: inBuildBrowser -> visible, else collapse). -->
				<Panel id="BBTTabBtnHost" class="BBTTabBtnHost BBTNoTranslate">
					<TextButton id="BBTTranslateButton2" class="Medium Fill BBTNoTranslate" text="翻译" hittest="true" onactivate="BBTActivate(&apos;translate&apos;, $.GetContextPanel());" onmouseactivate="BBTActivate(&apos;translate&apos;, $.GetContextPanel());" />
					<Label id="BBTActMark2" class="BBTActMark BBTNoTranslate" hittest="false" />
				</Panel>
			</Panel>
				<Panel id="ControlArea">
					<Panel class="ExtraInfo">
						<CitadelAvatarImage id="AuthorAvatar" />
						<Panel id="BuildMetaData" class="TopBottomFlow">
							<Panel id="Versioning" class="LeftRightFlow">
								<Label class="Version" html="true" text="#Citadel_HeroBuilds_Version" />
								<Panel class="LeftRightFlow buildIDbox">
									<Label class="BuildID" text="#Citadel_HeroBuilds_BuildID" onactivate="CitadelCopySelectedBuildIDToClipboard()" />
									<Label class="CopiedToClipboard" text="#Citadel_HeroBuilds_BuildID_Copied" />
								</Panel>
							</Panel>
							<Panel id="BuildUpdated" class="LeftRightFlow">
								<Label class="LastUpdated" html="true" text="#Citadel_HeroBuilds_LastUpdatedTime" />
							</Panel>
						</Panel>
					</Panel>
					<!-- BBT toolbar: one plain trigger button next to the engine's
					     出装选项 button, inside the engine's own #BuildControls row
					     (Medium Fill, same look; no dropdown arrow since v1.9.16).
					     Click = translate this page: offline memory first, bridge batch
					     when reachable (the bridge probes on demand from the click,
					     v1.9.16). The v1.9.15 dropdown (原文/翻译/中英对照 modes) was dropped - in game the static
					     menu surfaced as a floating clipped list that looked like
					     it appeared out of nowhere.
					     BBTNoTranslate: our own chrome, not game text - the
					     scanner must never harvest or rewrite it.
					     Every handler passes $.GetContextPanel() so the action
					     lands in the layout instance the user is looking at.
					     uiGuard de-duplicates the onactivate/onmouseactivate
					     pair. #BBTActMark2 is the uiGuard ledger marker. -->
				<!-- BBT toolbar: the v1.9.26 two-state trigger lived in this row
					 (next to the 出装选项 dropdown) and the Medium Fill squeeze made
					 it overlap the engine's 复制出装/BuildOptions controls on the
					 browser overview (field bug ①, v1.9.26). v1.9.27 moves the
					 trigger into the #BBTTabBtnHost anchor at the right edge of the
					 .AuthoringInfo title row - the button element itself moved there
					 in the XML; this row keeps only the engine's own controls.
					 BBTActivate/BTNActivate handlers are still exported for the
					 moved button. -->
					<Panel id="BuildControls">
						<Button />
						<TextButton id="BuildOptionButton" class="Medium Fill" text="#Citadel_HeroBuilds_BuildOptions" onactivate="$.GetContextPanel().ToggleClass(&apos;ShowBuildControlsContainer&apos;)">
							<Panel class="DropdownArrow" />
						</TextButton>
					</Panel>
				</Panel>
				<Panel id="BuildDetails">
					<Panel id="DetailsTop">
						<Panel id="BuildDetailsTabs">
							<Panel id="BuildOverviewTab" class="details_tab tab_selected">
								<Panel class="tab_bg" />
								<Label class="tab_label" text="#Citadel_HeroBuilds_Overview" />
							</Panel>
						</Panel>
						<Panel class="TagList">
							<CitadelBuildTag class="BuildTag NoHover Small" id="BuildTag1" />
							<CitadelBuildTag class="BuildTag NoHover Small" id="BuildTag2" />
							<CitadelBuildTag class="BuildTag NoHover Small" id="BuildTag3" />
						</Panel>
					</Panel>
					<Panel id="BuildDetails_Overview">
						<!-- engine-owned (text="#Token" whose value is {s:selected_hero_build_description}) -->
						<Label class="BuildDescription" text="#Citadel_HeroBuilds_BuildDescription" />
						<CitadelShopModsBuild id="ShopModsBuild" />
						<Panel class="ModListContainer">
							<CitadelModsPurchasedPanel id="mod_universal" class="ModList" mod_category="Universal" read_only="true" />
							<CitadelModsPurchasedPanel id="mod_universal_locked" class="ModList" mod_category="Locked Universal" read_only="true" />
						</Panel>
						<CitadelAbilityOrder id="AbilityOrder" />
					</Panel>
				</Panel>
			</Panel>
			<Panel id="BuildControlsContainer">
				<TextButton id="CopyBuildButton" class="Medium Fill" text="#Citadel_HeroBuilds_CopyBuildLabel" onmouseover="UIShowTextTooltipStyled( #Citadel_HeroBuilds_CopyBuildTooltip, OptionsTooltip)" onmouseout="UIHideTextTooltip()" html="true" onmouseactivate="CitadelBuildBrowserPopupConfirmBuild(); CitadelHudHeroBuildsCopyAndEditSelectedBuild()" />
				<TextButton id="CopyToClipboardBuildButton" class="Medium Fill" text="#Citadel_HeroBuilds_CopyToClipboard" onmouseover="UIShowTextTooltipStyled( #Citadel_HeroBuilds_CopyToClipboardTooltip, OptionsTooltip)" onmouseout="UIHideTextTooltip()" html="true" onmouseactivate="$.GetContextPanel().RemoveClass(&apos;ShowBuildControlsContainer&apos;); $.DispatchEvent(&apos;CitadelCopySelectedBuildContentsToClipboard&apos;,0)" />
				<Panel id="AuthorControls">
					<TextButton id="EditBuildButton" class="Medium Fill" text="#Citadel_HeroBuilds_EditBuildLabel" onmouseover="UIShowTextTooltipStyled( #Citadel_HeroBuilds_EditBuildTooltip, OptionsTooltip)" onmouseout="UIHideTextTooltip()" html="true" onmouseactivate="CitadelBuildBrowserPopupConfirmBuild(); CitadelHudHeroBuildsEditSelectedBuild()" />
					<TextButton id="PublishBuildButton" class="Medium Fill" text="#Citadel_HeroBuilds_PublishBuildLabel" onmouseover="UIShowTextTooltipStyled( #Citadel_HeroBuilds_PublishBuildTooltip, OptionsTooltip)" onmouseout="UIHideTextTooltip()" html="true" onmouseactivate="$.GetContextPanel().RemoveClass(&apos;ShowBuildControlsContainer&apos;); $.DispatchEvent(&apos;CitadelHudHeroBuildsPublishSelectedBuild&apos;)" />
					<TextButton id="RevertBuildButton" class="Medium Fill" text="#Citadel_HeroBuilds_RevertBuildLabel" onmouseover="UIShowTextTooltipStyled( #Citadel_HeroBuilds_RevertBuildTooltip, OptionsTooltip)" onmouseout="UIHideTextTooltip()" html="true" onmouseactivate="$.GetContextPanel().RemoveClass(&apos;ShowBuildControlsContainer&apos;); $.DispatchEvent(&apos;CitadelHudHeroBuildsRevertSelectedBuild&apos;)" />
					<TextButton id="DeleteBuildButton" class="Medium Fill" text="#Citadel_HeroBuilds_DeleteBuildLabel" onmouseover="UIShowTextTooltipStyled( #Citadel_HeroBuilds_DeleteBuildTooltip, OptionsTooltip)" onmouseout="UIHideTextTooltip()" html="true" onmouseactivate="$.GetContextPanel().RemoveClass(&apos;ShowBuildControlsContainer&apos;); $.DispatchEvent(&apos;CitadelHudHeroBuildsDeleteSelectedBuildPressed&apos;,true)" />
					<TextButton id="ValveBuildButton" class="Medium Fill" text="#Citadel_HeroBuilds_ValveBuildLabel" html="true" onmouseactivate="$.GetContextPanel().RemoveClass(&apos;ShowBuildControlsContainer&apos;); $.DispatchEvent(&apos;CitadelHudHeroBuildsAddToValveAuthoredBuilds&apos;)" />
				</Panel>
			</Panel>
		</Panel>
	</CitadelBuildDetails>
</root>
