<?xml version="1.0" encoding="utf-8"?>
<!--
  BuildBrowser Translation - override of panorama/layout/citadel_shop_mods_build.xml
  Base structure decompiled from the shipped citadel_shop_mods_build.vxml_c
  (Source 2 Viewer), unchanged except for the added scripts include.
  This layout is used both by the in-game shop build page and by the build
  browser's right-hand "BuildDetails" panel, so it also covers category names,
  category descriptions and per-item annotations.
-->
<root>
	<styles>
		<include src="s2r://panorama/styles/citadel_base_styles.vcss" />
		<include src="s2r://panorama/styles/citadel_shop_mods_list.vcss" />
		<include src="s2r://panorama/styles/citadel_shop_mods_build.vcss" />
		<include src="s2r://panorama/styles/bba.css" />
	</styles>
	<scripts>
		<include src="s2r://panorama/scripts/bba_glossary.vjs_c" />
		<include src="s2r://panorama/scripts/bba_tm.vjs_c" />
		<include src="s2r://panorama/scripts/bba_layout_tokens.vjs_c" />
		<include src="s2r://panorama/scripts/bba_translate.vjs_c" />
	</scripts>
	<snippets>
		<snippet name="FavoriteBuildEntry">
			<Panel class="FavoriteBuildEntryContainer">
				<!-- engine-owned build name; the 1px probe keeps the current text readable -->
				<Label class="BBTSrc FavoriteBuildEntryLabel SelectedBuildName" text="#Citadel_HeroBuilds_BuildName" html="true" />
				<Label class="BBTProbe FavoriteBuildEntryLabel SelectedBuildName" text="#Citadel_HeroBuilds_BuildName" html="true" />
				<Panel class="TagList">
					<CitadelBuildTag class="BuildTag Small" id="BuildTag1" />
					<CitadelBuildTag class="BuildTag Small" id="BuildTag2" />
					<CitadelBuildTag class="BuildTag Small" id="BuildTag3" />
				</Panel>
			</Panel>
		</snippet>
	</snippets>
	<CitadelShopModsBuild class="shopModsBuild" hittest="true">
		<Panel class="BuildBG" hittest="false" />
		<Panel id="CategoryContainer" />
		<Panel class="BuildHeader BuildHeaderShared">
			<Panel class="BuildHeaderContainer" onactivate="CitadelHudHeroBuildsToggleFavoriteSelector();">
				<Panel id="SelectedBuildOuter" />
			</Panel>
			<Panel id="ControlButtons">
				<Panel class="BuildDetails InfoIcon" onmouseover="UIShowCustomLayoutTooltip( BuildDetailsTooltip, file://{resources}/layout/tooltips/citadel_tooltip_build_details.xml )" onmouseout="UIHideCustomLayoutTooltip( BuildDetailsTooltip )" />
				<CitadelButton id="PasteFromClipboardButton" class="HasImage Medium Fill Dark" imagesrc="s2r://panorama/images/icons/icon_copy_paste.vsvg" onmouseover="UIShowTextTooltip( #Citadel_HeroBuilds_PasteFromClipboard )" onmouseout="UIHideTextTooltip()" onmouseactivate="CitadelHudHeroBuildsPasteBuildFromClipboard();" />
				<CitadelButton id="CopyToClipboardButton" class="HasImage Medium Fill Dark" imagesrc="s2r://panorama/images/icons/icon_copy_plus.vsvg" onmouseover="UIShowTextTooltip( #Citadel_HeroBuilds_CopyToClipboard )" onmouseout="UIHideTextTooltip()" onmouseactivate="CitadelCopySelectedBuildContentsToClipboard(0);" />
				<CitadelButton id="EditHeroBuildButton" class="Medium Fill Dark visibleByDefault EditModeButton" text="#Citadel_HeroBuilds_EditBuildLabel" onmouseover="UIShowTextTooltip( #Citadel_HeroBuilds_EditBuild )" onmouseout="UIHideTextTooltip()" onmouseactivate="CitadelHudHeroBuildsEditSelectedBuild()" />
				<CitadelButton id="AddToQueueButton" class="HasImage Medium Fill Dark" text="#Citadel_HeroBuilds_AddToQueue" imagesrc="s2r://panorama/images/icons/icon_quickbuy_queue.vsvg" onmouseover="UIShowTextTooltip( #Citadel_HeroBuilds_QueueFullBuild )" onmouseout="UIHideTextTooltip()" onmouseactivate="CitadelHudHeroBuildsQuickbuyQueueFullBuild();" />
				<CitadelButton id="BrowseBuildsButton" class="BuildHeaderButton Medium Dark Fill" text="#Citadel_HeroBuilds_BrowseBuilds" />
				<CitadelButton class="Medium Dark Fill visibleByDefault EditModeButton" text="#Citadel_HeroBuilds_CompactAll" onmouseover="UIShowTextTooltip( #Citadel_HeroBuilds_CompactAllTooltip )" onmouseout="UIHideTextTooltip()" onmouseactivate="CitadelHudHeroBuildsCompactCategory( -1 )" />
				<CitadelButton class="AddCategoryButton Medium Dark Fill visibleByDefault EditModeButton" text="#Citadel_HeroBuilds_AddCategory" onmouseactivate="CitadelHudHeroBuildsAddNewCategory()" />
			</Panel>
		</Panel>
		<Panel id="FavoriteBuildList" />
		<Panel class="ClipboardToast TertiaryButton">
			<Label class="CopyLabel" text="#Citadel_HeroBuilds_CopyToClipboardToast" />
			<Label class="PasteLabel" text="#Citadel_HeroBuilds_PasteFromClipboardToast" />
		</Panel>
	</CitadelShopModsBuild>
</root>
